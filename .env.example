# Copy this file to .env and fill in one provider.
# Fastest free start: Groq  →  https://console.groq.com/keys

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Optional alternatives (set LLM_PROVIDER accordingly)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# How many think→act loops the agent may run per question
MAX_STEPS=8

# Login (Google / GitHub). Redirect URLs:
#   http://127.0.0.1:7860/auth/google/callback
#   http://127.0.0.1:7860/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
AUTH_BASE_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000

# Production (Railway sets PORT). Example:
# FRONTEND_URL=https://your-app.up.railway.app
# AUTH_BASE_URL=https://your-app.up.railway.app
